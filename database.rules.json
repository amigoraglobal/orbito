{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid"
      }
    },
    "bans": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
      }
    },
    "waiting": {
      "$pool": {
        ".read": "auth != null",
        ".indexOn": ["ts"],
        "$uid": {
          ".write": "auth != null && !root.child('bans').child(auth.uid).exists()"
        }
      }
    },
    "matches": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && !root.child('bans').child(auth.uid).exists()"
      }
    },
    "calls": {
      "$callId": {
        ".read": "auth != null",
        ".write": "auth != null && !root.child('bans').child(auth.uid).exists()"
      }
    },
    "reports": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": ["ts"],
      "$id": {
        ".write": "(auth != null && !data.exists() && !root.child('bans').child(auth.uid).exists()) || (auth != null && root.child('admins').child(auth.uid).exists())",
        ".validate": "newData.hasChildren(['by','against','ts']) && newData.child('by').val() == auth.uid"
      }
    }
  }
}
